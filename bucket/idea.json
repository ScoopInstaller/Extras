    ],
    "architecture": {
        "64bit": {
            "url": "https://download.jetbrains.com/idea/idea-2026.2.2.win.zip",
            "hash": "5a8b7af34ac62b83914435bc54a0b5062f20bc70586f2c1aa31c6602af8aabf6",
            "bin": [
                [
                    "IDE\\bin\\idea64.exe",
