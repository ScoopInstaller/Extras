{
    "##": "The NSIS installer is unpacked instead of executed: it runs a custom PowerShell script and registers an uninstaller, neither of which belongs to a portable Scoop install.",
    "version": "0.4.1",
    "description": "Open source AI video agent that turns coding agents into video agents",
    "homepage": "https://openfilm.dev",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/openfilm/openfilm/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/openfilm/openfilm/releases/download/v0.4.1/OpenFilm-Setup-x64.exe#/dl.7z",
            "hash": "5edac2c23e723756722eb9d6896710d48cb4985105cdf55e211cca85da029bf5"
        }
    },
    "installer": {
        "script": [
            "Get-Item -Path \"$dir\\`$PLUGINSDIR\\app-64.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "# The built-in updater would install a second copy outside Scoop; without the feed the app reports it never updates",
            "Remove-Item -Path \"$dir\\resources\\app-update.yml\" -Force -ErrorAction Ignore",
            "Remove-Item -Path \"$dir\\`$PLUGINSDIR\", \"$dir\\`$R0\", \"$dir\\uninstallerIcon.ico\" -Recurse -Force -ErrorAction Ignore"
        ]
    },
    "shortcuts": [
        [
            "OpenFilm.exe",
            "OpenFilm"
        ]
    ],
    "checkver": {
        "github": "https://github.com/openfilm/openfilm"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openfilm/openfilm/releases/download/v$version/OpenFilm-Setup-x64.exe#/dl.7z"
            }
        }
    }
}
