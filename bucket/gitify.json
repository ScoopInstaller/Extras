{
    "version": "8.0.0",
    "description": "GitHub notifications on menu bar",
    "homepage": "https://www.gitify.io",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/gitify-app/gitify/releases/download/v8.0.0/Gitify-Setup-8.0.0.exe#/dl.7z",
            "hash": "sha512:6bd5f39718e755522ce4a9ea71e77940940f912e7fd0f8887161fa1934240458785a0b6370412ab134f77f25b38df8c4862435f2cf3a2d2df318121c5dad2a5d",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Gitify.exe",
            "Gitify"
        ]
    ],
    "checkver": {
        "github": "https://github.com/gitify-app/gitify"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gitify-app/gitify/releases/download/v$version/Gitify-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512:\\s+$base64"
        }
    }
}
