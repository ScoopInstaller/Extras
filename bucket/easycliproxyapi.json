{
    "version": "0.3.114",
    "description": "Cross-platform GUI desktop management client for CLIProxyAPI",
    "homepage": "https://github.com/router-for-me/EasyCLIProxyAPI",
    "license": "MIT",
    "suggest": {
        "Microsoft Edge WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v0.3.114/EasyCLIProxyAPI-v0.3.114-Windows-amd64.zip",
            "hash": "0aba565b3d09955edb0407e0f03fe8429a4a9b06621173722507117d8ee81b66",
            "extract_dir": "EasyCLIProxyAPI-v0.3.114-Windows-amd64"
        },
        "arm64": {
            "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v0.3.114/EasyCLIProxyAPI-v0.3.114-Windows-aarch64.zip",
            "hash": "4789904673792fface8d3e4c4dd648b1c3df29f1784a18590bf30f40cf037325",
            "extract_dir": "EasyCLIProxyAPI-v0.3.114-Windows-aarch64"
        }
    },
    "pre_install": [
        "$portableManifest = Get-Content -LiteralPath \"$dir\\portable-app.json\" -Raw | ConvertFrom-Json",
        "$portableManifest.autoUpdate = $false",
        "",
        "[System.IO.File]::WriteAllText(\"$dir\\portable-app.json\", ($portableManifest | ConvertTo-Json -Depth 10))",
        "$defaults = @{",
        "    'config.toml' = ''",
        "    'theme-selection.json' = '{\"version\":1,\"selectedId\":\"light\"}'",
        "    'privacy-mode.json' = 'false'",
        "    'usage-view-preferences.json' = '{}'",
        "    'skill-states.json' = '{}'",
        "    'mcp-servers.json' = '[]'",
        "}",
        "foreach ($file in $defaults.Keys) {",
        "    if (!(Test-Path -LiteralPath \"$persist_dir\\$file\") -and !(Test-Path -LiteralPath \"$dir\\$file\")) {",
        "        $defaults[$file] | Set-Content -LiteralPath \"$dir\\$file\" -Encoding Ascii -ErrorAction Stop",
        "    }",
        "}",
        "if (!(Test-Path \"$persist_dir\\cpa-core\\config.yaml\")) {",
        "    Get-Item \"$dir\\cpa-core\\CLIProxyAPI_*.zip\" | Expand-7zipArchive -DestinationPath \"$dir\\cpa-core\" -Switches 'config.example.yaml'",
        "    $config = Get-Content \"$dir\\cpa-core\\config.example.yaml\" -Raw -Encoding UTF8",
        "    # Add EasyCLIProxyAPI defaults",
        "    $config = $config -replace '(?m)^  host:[^\\r\\n]*', '  host: 127.0.0.1'",
        "    $config = $config -replace '(?m)^  api-keys:\\r?\\n(?:    - [^\\r\\n]*\\r?\\n)+', \"  api-keys:`n    - '123456'`n\"",
        "    $config = $config -replace '(?m)^  auth-dir:[^\\r\\n]*', '  auth-dir: ../oauth'",
        "    $config = $config -replace '(?m)^    usage-statistics-enabled:[^\\r\\n]*', '    usage-statistics-enabled: true'",
        "    $config = $config -replace '(?m)^  session-affinity-ttl:[^\\r\\n]*', '  session-affinity-ttl: \"\"'",
        "    $config = $config -replace '(?m)^requests:\\r?$', \"requests:`n  streaming: {bootstrap-retries: 0}\"",
        "    [System.IO.File]::WriteAllText(\"$dir\\cpa-core\\config.yaml\", $config, (New-Object System.Text.UTF8Encoding $false))",
        "}"
    ],
    "pre_uninstall": [
        "# File saves can replace the file, which can break Scoop's hardlink.",
        "foreach ($file in $manifest.persist) {",
        "    $source = Get-Item -LiteralPath \"$dir\\$file\" -ErrorAction SilentlyContinue",
        "    $target = Join-Path $persist_dir $file",
        "    if (!$source) { continue }",
        "    if (!$source.PSIsContainer) {",
        "        New-Item -ItemType Directory -Path (Split-Path -Parent $target) -Force -ErrorAction Stop | Out-Null",
        "        $content = [System.IO.File]::ReadAllBytes($source.FullName)",
        "        [System.IO.File]::WriteAllBytes($target, $content)",
        "    } elseif (!$source.LinkType) {",
        "        New-Item -ItemType Directory -Path $target -Force -ErrorAction Stop | Out-Null",
        "        Get-ChildItem -LiteralPath $source.FullName -Force | Copy-Item -Destination $target -Recurse -Force -ErrorAction Stop",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "EasyCLIProxyAPI.exe",
            "EasyCLIProxyAPI"
        ]
    ],
    "persist": [
        "agents",
        "config.toml",
        "theme-selection.json",
        "themes",
        "oauth",
        "usage-records",
        "cpa-core\\config.yaml",
        "privacy-mode.json",
        "usage-view-preferences.json",
        "skill-states.json",
        "mcp-servers.json",
        "agent-usage"
    ],
    "checkver": {
        "github": "https://github.com/router-for-me/EasyCLIProxyAPI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v$version/EasyCLIProxyAPI-v$version-Windows-amd64.zip",
                "extract_dir": "EasyCLIProxyAPI-v$version-Windows-amd64"
            },
            "arm64": {
                "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v$version/EasyCLIProxyAPI-v$version-Windows-aarch64.zip",
                "extract_dir": "EasyCLIProxyAPI-v$version-Windows-aarch64"
            }
        }
    }
}
