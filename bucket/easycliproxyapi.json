{
    "version": "0.3.98",
    "description": "Cross-platform GUI desktop management client for CLIProxyAPI",
    "homepage": "https://github.com/router-for-me/EasyCLIProxyAPI",
    "license": "MIT",
    "suggest": {
        "Microsoft Edge WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v0.3.98/EasyCLIProxyAPI-v0.3.98-Windows-amd64.zip",
            "hash": "81f93fd02de97511f988bbfb8f4cf154f978a3dafe62010dec04c4974aaebddc",
            "extract_dir": "EasyCLIProxyAPI-v0.3.98-Windows-amd64"
        },
        "arm64": {
            "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v0.3.98/EasyCLIProxyAPI-v0.3.98-Windows-aarch64.zip",
            "hash": "0d82a019cbb2d666659a5591cb7bd905b1fa335189694176939c60a8ddab574e",
            "extract_dir": "EasyCLIProxyAPI-v0.3.98-Windows-aarch64"
        }
    },
    "pre_install": [
        "# 'agents' was not persisted before; migrate it from the previously active version directory.",
        "$agentsTarget = \"$persist_dir\\agents\"",
        "$hasPersistedAgents = (Test-Path -LiteralPath $agentsTarget) -and (Get-ChildItem -LiteralPath $agentsTarget -Force -ErrorAction Stop | Select-Object -First 1)",
        "if ($old_version -and !$hasPersistedAgents) {",
        "    $appDir = Split-Path $dir -Parent",
        "    $previousAgents = if ($old_version -eq $version) {",
        "        # Forced reinstall: Scoop renames the active directory to the first unused '_<version>.old' / '_<version>.old(<n>)'.",
        "        $backup = $null",
        "        $i = 0",
        "        while ($true) {",
        "            $candidate = if ($i -eq 0) { \"$appDir\\_$version.old\" } else { \"$appDir\\_$version.old($i)\" }",
        "            if (!(Test-Path -LiteralPath $candidate)) { break }",
        "            $backup = $candidate",
        "            $i += 1",
        "        }",
        "        if ($backup) { Join-Path $backup 'agents' }",
        "    } else {",
        "        \"$appDir\\$old_version\\agents\"",
        "    }",
        "    $previousAgents = @($previousAgents) | Where-Object {",
        "        (Test-Path -LiteralPath $_) -and -not ((Get-Item -LiteralPath $_ -Force -ErrorAction Stop).Attributes -band [System.IO.FileAttributes]::ReparsePoint)",
        "    } | Select-Object -First 1",
        "    if ($previousAgents) {",
        "        $tempAgents = \"$persist_dir\\agents.migrating\"",
        "        try {",
        "            info \"Migrating agent data from '$previousAgents'\"",
        "            if (Test-Path -LiteralPath $tempAgents) { Remove-Item -LiteralPath $tempAgents -Recurse -Force -ErrorAction Stop }",
        "            New-Item -ItemType Directory -Path $persist_dir -Force -ErrorAction Stop | Out-Null",
        "            # Copy first so the source stays recoverable until the final same-volume rename succeeds.",
        "            Copy-Item -LiteralPath $previousAgents -Destination $tempAgents -Recurse -Force -ErrorAction Stop",
        "            if (Test-Path -LiteralPath $agentsTarget) { Remove-Item -LiteralPath $agentsTarget -Recurse -Force -ErrorAction Stop }",
        "            Move-Item -LiteralPath $tempAgents -Destination $agentsTarget -ErrorAction Stop",
        "        } catch {",
        "            if (Test-Path -LiteralPath $tempAgents) { Remove-Item -LiteralPath $tempAgents -Recurse -Force -ErrorAction SilentlyContinue }",
        "            # The source was never modified, so a partially populated destination is redundant.",
        "            if ((Test-Path -LiteralPath $previousAgents) -and (Test-Path -LiteralPath $agentsTarget)) {",
        "                Remove-Item -LiteralPath $agentsTarget -Recurse -Force -ErrorAction SilentlyContinue",
        "            }",
        "            abort \"Failed to migrate agent data from '$previousAgents': $_\"",
        "        }",
        "        Remove-Item -LiteralPath $previousAgents -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "if (!(Test-Path \"$persist_dir\\config.toml\")) {",
        "    New-Item -ItemType File -Path \"$dir\\config.toml\" -Force | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\theme-selection.json\")) {",
        "    '{\"version\":1,\"selectedId\":\"light\"}' | Set-Content \"$dir\\theme-selection.json\" -Encoding Ascii",
        "}",
        "if (!(Test-Path \"$persist_dir\\cpa-core\\config.yaml\")) {",
        "    Get-Item \"$dir\\cpa-core\\CLIProxyAPI_*.zip\" | Expand-7zipArchive -DestinationPath \"$dir\\cpa-core\" -Switches 'config.example.yaml'",
        "    $config = Get-Content \"$dir\\cpa-core\\config.example.yaml\" -Raw -Encoding UTF8",
        "    # Add EasyCLIProxyAPI defaults",
        "    $config = $config -replace '(?m)^  host:[^\\r\\n]*', '  host: 127.0.0.1'",
        "    $config = $config -replace '(?m)^  api-keys:\\r?\\n(?:    - [^\\r\\n]*\\r?\\n)+', \"  api-keys:`n    - '123456'`n\"",
        "    $config = $config -replace '(?m)^  auth-dir:[^\\r\\n]*', '  auth-dir: ../oauth'",
        "    $config = $config -replace '(?m)^    usage-statistics-enabled:[^\\r\\n]*', '    usage-statistics-enabled: true'",
        "    $config = $config -replace '(?m)^  session-affinity-ttl:[^\\r\\n]*', '  session-affinity-ttl: \"\"'",
        "    $config = $config -replace '(?m)^requests:\\r?$', \"requests:`n  streaming: {bootstrap-retries: 0}\"",
        "    [System.IO.File]::WriteAllText(\"$dir\\cpa-core\\config.yaml\", $config, (New-Object System.Text.UTF8Encoding $false))",
        "}"
    ],
    "pre_uninstall": [
        "# Theme saves replace the file, which can break Scoop's hardlink.",
        "if (Test-Path -LiteralPath \"$dir\\theme-selection.json\" -PathType Leaf) {",
        "    New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "    $themeSelection = [System.IO.File]::ReadAllBytes(\"$dir\\theme-selection.json\")",
        "    [System.IO.File]::WriteAllBytes(\"$persist_dir\\theme-selection.json\", $themeSelection)",
        "}"
    ],
    "shortcuts": [
        [
            "EasyCLIProxyAPI.exe",
            "EasyCLIProxyAPI"
        ]
    ],
    "persist": [
        "agents",
        "config.toml",
        "theme-selection.json",
        "themes",
        "oauth",
        "usage-records",
        "cpa-core\\config.yaml"
    ],
    "checkver": {
        "github": "https://github.com/router-for-me/EasyCLIProxyAPI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v$version/EasyCLIProxyAPI-v$version-Windows-amd64.zip",
                "extract_dir": "EasyCLIProxyAPI-v$version-Windows-amd64"
            },
            "arm64": {
                "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v$version/EasyCLIProxyAPI-v$version-Windows-aarch64.zip",
                "extract_dir": "EasyCLIProxyAPI-v$version-Windows-aarch64"
            }
        }
    }
}
