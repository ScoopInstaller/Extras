{
    "version": "0.3.101",
    "description": "Cross-platform GUI desktop management client for CLIProxyAPI",
    "homepage": "https://github.com/router-for-me/EasyCLIProxyAPI",
    "license": "MIT",
    "suggest": {
        "Microsoft Edge WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v0.3.101/EasyCLIProxyAPI-v0.3.101-Windows-amd64.zip",
            "hash": "a92ef4e37c738411f4be012166b85c2a982f0e6adfea0784539a00ffae43e5de",
            "extract_dir": "EasyCLIProxyAPI-v0.3.101-Windows-amd64"
        },
        "arm64": {
            "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v0.3.101/EasyCLIProxyAPI-v0.3.101-Windows-aarch64.zip",
            "hash": "d8df86cb63998a1a48fe8b5a1f38c7746eea185537a843a3969ac4a4215ed711",
            "extract_dir": "EasyCLIProxyAPI-v0.3.101-Windows-aarch64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config.toml\")) {",
        "    New-Item -ItemType File -Path \"$dir\\config.toml\" -Force | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\theme-selection.json\")) {",
        "    '{\"version\":1,\"selectedId\":\"light\"}' | Set-Content \"$dir\\theme-selection.json\" -Encoding Ascii",
        "}",
        "if (!(Test-Path \"$persist_dir\\cpa-core\\config.yaml\")) {",
        "    Get-Item \"$dir\\cpa-core\\CLIProxyAPI_*.zip\" | Expand-7zipArchive -DestinationPath \"$dir\\cpa-core\" -Switches 'config.example.yaml'",
        "    $config = Get-Content \"$dir\\cpa-core\\config.example.yaml\" -Raw -Encoding UTF8",
        "    # Add EasyCLIProxyAPI defaults",
        "    $config = $config -replace '(?m)^  host:[^\\r\\n]*', '  host: 127.0.0.1'",
        "    $config = $config -replace '(?m)^  api-keys:\\r?\\n(?:    - [^\\r\\n]*\\r?\\n)+', \"  api-keys:`n    - '123456'`n\"",
        "    $config = $config -replace '(?m)^  auth-dir:[^\\r\\n]*', '  auth-dir: ../oauth'",
        "    $config = $config -replace '(?m)^    usage-statistics-enabled:[^\\r\\n]*', '    usage-statistics-enabled: true'",
        "    $config = $config -replace '(?m)^  session-affinity-ttl:[^\\r\\n]*', '  session-affinity-ttl: \"\"'",
        "    $config = $config -replace '(?m)^requests:\\r?$', \"requests:`n  streaming: {bootstrap-retries: 0}\"",
        "    [System.IO.File]::WriteAllText(\"$dir\\cpa-core\\config.yaml\", $config, (New-Object System.Text.UTF8Encoding $false))",
        "}"
    ],
    "pre_uninstall": [
        "# Theme saves replace the file, which can break Scoop's hardlink.",
        "if (Test-Path -LiteralPath \"$dir\\theme-selection.json\" -PathType Leaf) {",
        "    New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
        "    $themeSelection = [System.IO.File]::ReadAllBytes(\"$dir\\theme-selection.json\")",
        "    [System.IO.File]::WriteAllBytes(\"$persist_dir\\theme-selection.json\", $themeSelection)",
        "}"
    ],
    "shortcuts": [
        [
            "EasyCLIProxyAPI.exe",
            "EasyCLIProxyAPI"
        ]
    ],
    "persist": [
        "agents",
        "config.toml",
        "theme-selection.json",
        "themes",
        "oauth",
        "usage-records",
        "cpa-core\\config.yaml"
    ],
    "checkver": {
        "github": "https://github.com/router-for-me/EasyCLIProxyAPI"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v$version/EasyCLIProxyAPI-v$version-Windows-amd64.zip",
                "extract_dir": "EasyCLIProxyAPI-v$version-Windows-amd64"
            },
            "arm64": {
                "url": "https://github.com/router-for-me/EasyCLIProxyAPI/releases/download/v$version/EasyCLIProxyAPI-v$version-Windows-aarch64.zip",
                "extract_dir": "EasyCLIProxyAPI-v$version-Windows-aarch64"
            }
        }
    }
}
