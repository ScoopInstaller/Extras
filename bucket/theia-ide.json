{
    "version": "1.75.0",
    "description": "The Eclipse Theia IDE is a modern and open IDE for cloud and desktop, built on the Theia platform.",
    "homepage": "https://theia-ide.org/#theiaide",
    "license": "EPL-2.0, GPL-2.0, MIT",
    "notes": [
        "Add 'Open with Theia IDE' to directory context menu by running:",
        "reg import \"$dir\\install-context.reg\"",
        "Remove 'Open with Theia IDE' from directory context menu by running:",
        "reg import \"$dir\\uninstall-context.reg\"",
        "Auto Remove when 'uninstall'"
    ],
    "architecture": {
        "64bit": {
            "url": "https://www.eclipse.org/downloads/download.php?mirror_id=1&file=/theia/ide/1.75.0/windows/TheiaIDESetup-1.75.0.exe#/dl.7z",
            "hash": "sha512:a3c4a862800ffdc0502a3b73f6bea872f714b009831969d4c7d328deb0cd7e81c2d2993ef1e075393ee39259aaeab8354d86d0eb09f0cf48880c6ec3b46e73e9"
        }
    },
    "post_install": [
        "$exepath = \"$dir\\TheiaIDE.exe\".Replace('\\', '\\\\')",
        "'install-context', 'uninstall-context' | ForEach-Object {",
        "  if (Test-Path \"$bucketsdir\\extras\\scripts\\theia-ide\\$_.reg\") {",
        "    $content = Get-Content \"$bucketsdir\\extras\\scripts\\theia-ide\\$_.reg\"",
        "    $content = $content.Replace('$theiaide', $exepath)",
        "    if ($global) {",
        "      $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE')",
        "    }",
        "    $content | Set-Content -Path \"$dir\\$_.reg\"",
        "  }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    if (Test-Path \"$dir\\uninstall-context.reg\") {",
            "        reg import \"$dir\\uninstall-context.reg\"",
            "    }",
            "}"
        ]
    },
    "extract_dir": "$PLUGINSDIR",
    "installer": {
        "script": "Expand-7zipArchive \"$dir\\app-64.7z\" \"$dir\" -Removal"
    },
    "bin": "TheiaIDE.exe",
    "shortcuts": [
        [
            "TheiaIDE.exe",
            "TheiaIDE"
        ]
    ],
    "checkver": {
        "url": "https://download.eclipse.org/theia/ide/latest/windows/latest.yml",
        "regex": "version: ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.eclipse.org/downloads/download.php?mirror_id=1&file=/theia/ide/$version/windows/TheiaIDESetup-$version.exe#/dl.7z",
                "hash": {
                    "url": "https://download.eclipse.org/theia/ide/latest/windows/latest.yml",
                    "regex": "sha512: $base64"
                }
            }
        }
    }
}
