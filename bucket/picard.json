    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "http://ftp.musicbrainz.org/pub/musicbrainz/picard/picard-setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$url.md5"
        }
    }
