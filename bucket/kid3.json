{
    "version": "3.10.2",
    "description": "Efficient ID3v1 and ID3v2 tag editor",
    "homepage": "https://kid3.kde.org",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://downloads.sourceforge.net/project/kid3/kid3/3.10.2/kid3-3.10.2-win32-x64.zip",
            "hash": "sha1:4acb7f66535454c0901f5cd554dfe538e3833757"
        }
    },
    "pre_install": [
        "# Use a script to extract files since the extract_dir changes frequently.",
        "$items = Get-ChildItem -Path $dir | Select-Object -First 3",
        "if ($items.Count -eq 1 -and $items.PSIsContainer) {",
        "    $inner_dir = $items | ForEach-Object -MemberName FullName",
        "    Move-Item -Path \"$inner_dir\\*\" -Destination $dir -Force",
        "    Remove-Item -Path $inner_dir -Recurse -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "bin": [
        "kid3-cli.exe",
        [
            "kid3-cli.exe",
            "kid3"
        ]
    ],
    "shortcuts": [
        [
            "kid3.exe",
            "Kid3"
        ]
    ],
    "checkver": "kid3-((?<short>[\\d.]+)(?:-\\d+)?)-win32-x64\\.zip",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.sourceforge.net/project/kid3/kid3/$matchShort/kid3-$version-win32-x64.zip"
            }
        },
        "hash": {
            "url": "https://sourceforge.net/projects/kid3/files/kid3/$matchShort/",
            "regex": "$basename\".*?sha1\":\"$sha1\""
        }
    }
}
