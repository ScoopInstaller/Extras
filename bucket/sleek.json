    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-*.7z\" \"$dir\"",
        "Remove-Item \"$dir\\`$*\" -Force -Recurse",
        "if (!(Test-Path \"$persist_dir\\user-preferences.json\")) {",
        "    New-Item \"$dir\\user-preferences.json\" -ItemType File | Out-Null",
        "}"
    ],
    "bin": "sleek.exe",
    "shortcuts": [
