        },
        "arm64": {
            "url": "https://download.jetbrains.com/python/pycharm-2026.2.1-aarch64.win.zip",
            "hash": "1e3642349630d8eb275cabeec3eb6ba547e1e28e8190201381775a436ab2f2b4",
            "bin": [
                [
                    "IDE\\bin\\pycharm64.exe",
