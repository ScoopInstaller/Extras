    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "shortcuts": [
        [
            "Motrix.exe",
            "Motrix"
        ]
    ],
    "checkver": {
        "github": "https://github.com/agalwood/Motrix"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/agalwood/Motrix/releases/download/v$version/Motrix-$version-win.zip"
            },
            "arm64": {
                "url": "https://github.com/agalwood/Motrix/releases/download/v$version/Motrix-$version-arm64.zip"
            }
        }
    }
