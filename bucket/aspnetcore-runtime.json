{
    "version": "10.0.12",
    "description": "Microsoft ASP.NET Core (10.0 latest) Runtime, including the .NET Runtime, installed from the ZIP archive without admin rights",
    "homepage": "https://dotnet.microsoft.com/download/dotnet",
    "license": "MIT",
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.12/aspnetcore-runtime-10.0.12-win-x64.zip",
            "hash": "sha512:b6958736bd42eff9c78a27a489d43eb0a39c6201039070ecb76a93cb96c519f07c86fa8b62034c6dd1a82a4c8ad0bd781e052008a7ec4cc48f9f792227d9c7ac"
        },
        "32bit": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.12/aspnetcore-runtime-10.0.12-win-x86.zip",
            "hash": "sha512:248012bb409f9f6ee369c45832f5f20b66e765290572454cc475534ce64878edb5f38ec936d28cce42f4f9a2ba1654dd8238d8f91e5e01e3d4f70585cbe1d329"
        },
        "arm64": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.12/aspnetcore-runtime-10.0.12-win-arm64.zip",
            "hash": "sha512:d18b4c3015698ea64cdb3581d52984b3477703bd7e59600b88341343b5f35f6d8f8d353ecc560a2586c79796abef73d36c8fc0ccec954da8bebe8b49f3e032b9"
        }
    },
    "env_add_path": ".",
    "env_set": {
        "DOTNET_ROOT": "$dir"
    },
    "checkver": {
        "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/releases-index.json",
        "jsonpath": "$.releases-index[?(@.support-phase == 'active')].latest-runtime",
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/$version/aspnetcore-runtime-$version-win-x64.zip"
            },
            "32bit": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/$version/aspnetcore-runtime-$version-win-x86.zip"
            },
            "arm64": {
                "url": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/$version/aspnetcore-runtime-$version-win-arm64.zip"
            }
        },
        "hash": {
            "url": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/$majorVersion.$minorVersion/releases.json",
            "regex": "(?s)$basename.*?$sha512"
        }
    }
}
