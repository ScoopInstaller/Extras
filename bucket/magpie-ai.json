    "description": "Unified model, provider, and gateway manager for AI coding agents.",
    "homepage": "https://usemagpie.ai",
    "license": "MIT",
    "notes": "This manifest tracks the stable releases of Magpie. For the latest releases, use 'versions/magpie-ai-latest'",
    "architecture": {
        "64bit": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.2115/magpie-windows-amd64.exe#/magpie.exe",
            "hash": "d37546a89ecfd249aa582776af0d5cffe7e2114ed0a6d7f54462a2b3a73cffed"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.2115/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "b14a18a399e94cfb564a7cd793d0a488848fde7746fa0089e56e581e3952675d"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://usemagpie.ai/api/latest?channel=stable",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-amd64.exe#/magpie.exe"
            },
            "arm64": {
                "url": "https://github.com/yetone/magpie-releases/releases/download/v$version/magpie-windows-arm64.exe#/magpie.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
