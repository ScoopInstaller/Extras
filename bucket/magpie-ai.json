        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1953/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "637869e6d7f2aa6092c1f5393114b4074cd9141da8a1d0a04c4f90cbd831c3d0"
