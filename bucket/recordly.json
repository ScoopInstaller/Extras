{
    "version": "1.4.0",
    "description": "Open-source screen recorder and editor for walkthroughs, demos, product videos, and more.",
    "homepage": "https://recordly.dev",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/webadderallorg/Recordly/releases/download/v1.4.0/Recordly-windows-x64.exe#/dl.7z",
            "hash": "08f20bafb0d6cf82399b6e4d8d12f58cbf1821a1d93abdd1e944bb9727b66b20",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        }
    },
    "post_install": [
        "Remove-Item \"$dir\\`$*\" -Force -Recurse",
        "# Disable built-in update mechanism to prevent conflicts with Scoop-managed updates",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "(Get-Content $yaml -Encoding ASCII).replace('publishAutoUpdate: true', 'publishAutoUpdate: false') | Set-Content $yaml -Encoding ASCII"
    ],
    "bin": "Recordly.exe",
    "shortcuts": [
        [
            "Recordly.exe",
            "Recordly"
        ]
    ],
    "checkver": {
        "github": "https://github.com/webadderallorg/Recordly"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/webadderallorg/Recordly/releases/download/v$version/Recordly-windows-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
