{
    "version": "0.4.1001",
    "description": "A powerful harness of its own, and the best herdr GUI.",
    "homepage": "https://alma.now",
    "license": "Proprietary",
    "notes": "Please manually disable Alma's auto-update feature in the settings to prevent the updater from installing the program in unintended locations.",
    "suggest": {
        "herdr": "herdr"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/yetone/alma-releases/releases/download/v0.4.1001/alma-0.4.1001-win-x64.exe#/dl.7z",
            "hash": "sha512:c1c5ff2459ae2899b1b1c091834652ae952c7fd4cd5923c8dd401c2e2acd123893ee6e3e8149b04995de285eeb2d447759f2374b7745690c358ab1b3e459dbec"
        }
    },
    "pre_install": [
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse",
        "if (!(Test-Path \"$persist_dir\\ui-prefs.json\")) { New-Item \"$dir\\ui-prefs.json\" | Out-Null }"
    ],
    "shortcuts": [
        [
            "Alma.exe",
            "Alma"
        ]
    ],
    "env_set": {
        "ALMA_DATA_DIR": "$dir\\data",
        "ALMA_NATIVE_PREFS": "$dir\\ui-prefs.json"
    },
    "persist": [
        "data",
        "ui-prefs.json"
    ],
    "checkver": {
        "github": "https://github.com/yetone/alma-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yetone/alma-releases/releases/download/v$version/alma-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?s)$basename.*?sha512: $base64"
        }
    }
}
