    "pre_install": [
        "# Hardlinks cannot work properly here, as this app would create a new file instead of writing directly.",
        "# Abort the install if the restore fails; otherwise the default settings would overwrite the saved ones later.",
        "$ErrorActionPreference = 'Stop'",
        "if (Test-Path -Path \"$persist_dir\\DesktopClock.settings\" -PathType Leaf) {",
        "    Copy-Item -Path \"$persist_dir\\DesktopClock.settings\" -Destination $dir -Force",
        "}"
    ],
    "shortcuts": [
        [
            "DesktopClock.exe",
            "DesktopClock"
        ]
    ],
    "pre_uninstall": [
        "# Hardlinks cannot work properly here, as this app would create a new file instead of writing directly.",
        "# Abort the uninstall if the backup fails, instead of deleting the settings with the app directory.",
        "$ErrorActionPreference = 'Stop'",
        "if (Test-Path -Path \"$dir\\DesktopClock.settings\" -PathType Leaf) {",
        "    ensure $persist_dir | Out-Null",
        "    Copy-Item -Path \"$dir\\DesktopClock.settings\" -Destination $persist_dir -Force",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/danielchalmers/DesktopClock/releases/download/v$version/DesktopClock-$version-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/danielchalmers/DesktopClock/releases/download/v$version/DesktopClock-$version-arm64.zip"
            }
        }
    }
