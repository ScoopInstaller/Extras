    "pre_install": [
        "if (Test-Path \"$dir\\Telegram\\Telegram.exe\") {",
        "    Get-ChildItem \"$dir\\Telegram\" | Move-Item -Destination \"$dir\\\" -Force",
        "    Remove-Item \"$dir\\Telegram\" -Recurse -Force",
        "}",
        "if (Test-Path \"$persist_dir\\log.txt\") { Copy-Item \"$persist_dir\\log.txt\" \"$dir\\\" }"
    ],
    "pre_uninstall": "if (Test-Path \"$dir\\log.txt\") { Copy-Item \"$dir\\log.txt\" \"$persist_dir\\\" }",
    "bin": [
        "Telegram.exe",
        [
            "Telegram.exe",
            "Forkgram"
        ]
    ],
    "shortcuts": [
        [
            "Telegram.exe",
            "Forkgram"
        ]
    ],
    "persist": "tdata",
    "checkver": {
        "github": "https://github.com/forkgram/tdesktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/forkgram/tdesktop/releases/download/v$version/Telegram.zip"
            },
            "32bit": {
