{
    "version": "1.1.2",
    "description": "Mount a NAS, WebDAV share or cloud storage as a real local Windows drive letter",
    "homepage": "https://drive.scsoi.com",
    "license": {
        "identifier": "Proprietary",
        "url": "https://drive.scsoi.com/terms"
    },
    "url": "https://github.com/shuyingegit/scsdriver/releases/download/v1.1.2/scsdriver-1.1.2-setup-win64.exe",
    "hash": "bb1dda08846a1e1f744866ab42a41cd0f3b23b86903cf60690ea950b017102e9",
    "checkver": {
        "url": "https://github.com/shuyingegit/scsdriver/releases.atom",
        "regex": "releases/tag/v?([0-9.]+)\""
    },
    "installer": {
        "file": "scsdriver-1.1.2-setup-win64.exe",
        "args": ["/SP-", "/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART"]
    },
    "uninstaller": {
        "script": [
            "$roots = @(\"$env:LOCALAPPDATA\\Programs\\ScsDrive\", \"$env:ProgramFiles\\ScsDrive\", \"${env:ProgramFiles(x86)}\\ScsDrive\")",
            "$uninstaller = Get-ChildItem -Path $roots -Filter 'unins*.exe' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1",
            "if (-not $uninstaller) { throw 'ScsDrive uninstaller (unins*.exe) not found in the install directory.' }",
            "$p = Start-Process -FilePath $uninstaller.FullName -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART' -Wait -PassThru",
            "if ($p.ExitCode -ne 0) { throw \"ScsDrive uninstaller failed with exit code $($p.ExitCode).\" }"
        ]
    },
    "autoupdate": {
        "url": "https://github.com/shuyingegit/scsdriver/releases/download/v$version/scsdriver-$version-setup-win64.exe",
        "hash": { "url": "$url.digest" },
        "installer": { "file": "scsdriver-$version-setup-win64.exe" }
    }
}
