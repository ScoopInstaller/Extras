            "hash": "da1343cd7f30abb78a2e09d25c7ddf92a3996201b9407e3abb2a663b40d457b8",
            "extract_dir": "zeal-0.9.2-portable-windows-x64"
        },
        "arm64": {
            "url": "https://github.com/zealdocs/zeal/releases/download/v0.9.2/zeal-0.9.2-portable-windows-arm64.7z",
