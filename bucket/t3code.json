{
    "version": "0.0.35",
    "description": "Desktop app for orchestrating AI coding agents like Claude Code, Codex, Cursor CLI and OpenCode",
    "homepage": "https://github.com/pingdotgg/t3code",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/pingdotgg/t3code/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/pingdotgg/t3code/releases/download/v0.0.35/T3-Code-0.0.35-x64.exe#/dl.7z",
            "hash": "sha512:5322b9f16bf17bf8e6357c71be020978d712a2ac02e03ae149bc510769c6c03d4399d7b8a95a5c492ff91bd2c8bd4e7e7488d774d6567b6455c9c1148a01f2cf"
        }
    },
    "pre_install": [
        "Get-ChildItem -Path \"$dir\\`$PLUGINSDIR\\app*.7z\" | Rename-Item -NewName 'app.7z'",
        "Expand-7zipArchive -Path \"$dir\\`$PLUGINSDIR\\app.7z\" -DestinationPath \"$dir\"",
        "Remove-Item -Path \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "post_install": [
        "if (Test-Path $env:APPDATA\\t3code) {",
        "    Write-Host \"`r`nMove config from non-portable version...\"",
        "    Copy-Item -Path $env:APPDATA\\t3code\\* -Destination \"$persist_dir\\t3code\" -Force -Recurse | Out-Null",
        "    Remove-Item $env:APPDATA\\t3code -Force -Recurse",
        "}",
        "New-Item -ItemType Junction -Path $env:APPDATA\\t3code -Target \"$persist_dir\\t3code\" | Out-Null"
    ],
    "uninstaller": {
        "script": "Remove-Item $env:APPDATA\\t3code -Force -Recurse"
    },
    "shortcuts": [
        [
            "T3 Code (Alpha).exe",
            "T3 Code (Alpha)"
        ]
    ],
    "persist": "t3code",
    "checkver": {
        "github": "https://github.com/pingdotgg/t3code"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pingdotgg/t3code/releases/download/v$version/T3-Code-$version-x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "(?sm)x64.*?sha512:\\s+$base64"
                }
            }
        }
    }
}
