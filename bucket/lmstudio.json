    "architecture": {
        "64bit": {
            "url": "https://installers.lmstudio.ai/win32/x64/0.4.23-1/LM-Studio-0.4.23-1-x64.exe#/dl.7z",
            "hash": "8f7e0a098049f5d4bfafc45c61348ba5fcf76e579589639c599ff52d76c397a2"
        },
        "arm64": {
            "url": "https://installers.lmstudio.ai/win32/arm64/0.4.23-1/LM-Studio-0.4.23-1-arm64.exe#/dl.7z",
