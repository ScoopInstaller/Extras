                "extract_dir": "chrlauncher\\64"
            },
            "32bit": {
                "url": "https://github.com/henrypp/chrlauncher/releases/download/v.$version/chrlauncher-$version-bin.7z",
                "extract_dir": "chrlauncher\\32"
            }
        },
        "hash": {
            "url": "$baseurl/chrlauncher-$version.sha256"
        }
    }
}
