    },
    "suggest": {
        "Inno Script Studio": "extras/inno-script-studio"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/jrsoftware/issrc/releases/download/is-7_1_0/innosetup-7.1.0-x64.exe",
            "hash": "0362a383ed217d4c4239b5933866dd96d3eb2102737da92f80f6057a4b40df2f"
        },
        "32bit": {
            "url": "https://github.com/jrsoftware/issrc/releases/download/is-7_1_0/innosetup-7.1.0-x86.exe",
            "hash": "f9671174e0d15ba9b4f6b56564c6aed32ea8db9c3cb9bf6f2af0850fe7894f60"
        }
    },
    "innosetup": true,
    "bin": [
        "ISCC.exe",
        "ISSigTool.exe"
    ],
    "shortcuts": [
        [
            "ISIDE.exe",
            "Inno Setup Compiler"
        ]
    ],
    "checkver": {
        "github": "https://github.com/jrsoftware/issrc",
        "regex": "Inno Setup ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jrsoftware/issrc/releases/download/is-$underscoreVersion/innosetup-$version-x64.exe"
            },
            "32bit": {
                "url": "https://github.com/jrsoftware/issrc/releases/download/is-$underscoreVersion/innosetup-$version-x86.exe"
            }
        },
        "hash": {
            "url": "$url.issig",
            "find": "file-hash\\s+$sha256"
        }
    }
}
