            "hash": "8a5a6711c3766a6e5fb74f280ba0e3551e719ce94538d901fdbd1f8f9920b3f0"
        },
        "32bit": {
            "url": "https://github.com/jrsoftware/issrc/releases/download/is-7_1_1/innosetup-7.1.1-x86.exe",
            "hash": "03446e46f5da932e408881168c01afc59cc667cb5bc927d839c5526ace5cc0d3"
        }
    },
    "innosetup": true,
    "bin": [
        "ISCC.exe",
        "ISSigTool.exe"
    ],
    "shortcuts": [
        [
            "ISIDE.exe",
            "Inno Setup Compiler"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/jrsoftware/issrc/releases/latest",
        "jsonpath": "$.assets[?(@.name =~ /\\.exe/)].name",
        "regex": "innosetup-(\\d+(?:\\.\\d+)+)-x64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jrsoftware/issrc/releases/download/is-$underscoreVersion/innosetup-$version-x64.exe"
            },
            "32bit": {
                "url": "https://github.com/jrsoftware/issrc/releases/download/is-$underscoreVersion/innosetup-$version-x86.exe"
            }
        },
        "hash": {
            "url": "$url.issig",
            "find": "file-hash\\s+$sha256"
        }
    }
}
