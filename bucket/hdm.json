{
    "version": "1.1.0",
    "description": "A fast download manager with a desktop interface, CLI, and browser integration",
    "homepage": "https://hydra.javad.dev/",
    "license": "GPL-3.0-or-later",
    "notes": "Updates are managed by Scoop: the in-app update check is disabled on first install. Use 'scoop update hdm' to upgrade.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ja7ad/hydra/releases/download/v1.1.0/hydra-1.1.0-windows-amd64.zip",
            "hash": "91f0f0d8c90bfd871b8aceda64579f60e538eaad10db670a9a917639b70d1fe6",
            "extract_dir": "hydra-1.1.0-windows-amd64"
        },
        "arm64": {
            "url": "https://github.com/ja7ad/hydra/releases/download/v1.1.0/hydra-1.1.0-windows-arm64.zip",
            "hash": "506dd08808b6aa0b46e9bffa63b087a28fe9c69ee8dfa145b5f2ab3562a475eb",
            "extract_dir": "hydra-1.1.0-windows-arm64"
        }
    },
    "post_install": [
        "$config = \"$env:APPDATA\\hydra\\config.toml\"",
        "if (!(Test-Path -LiteralPath $config)) {",
        "    New-Item -ItemType Directory -Path (Split-Path -Parent $config) -Force | Out-Null",
        "    Set-Content -LiteralPath $config -Value \"[settings]`ncheck_updates_on_startup = false\" -Encoding ascii",
        "}"
    ],
    "bin": [
        "hydra.exe",
        [
            "hydra.exe",
            "hya"
        ]
    ],
    "shortcuts": [
        [
            "hydra-gui.exe",
            "Hydra Download Manager"
        ]
    ],
    "checkver": {
        "github": "https://github.com/ja7ad/hydra"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ja7ad/hydra/releases/download/v$version/hydra-$version-windows-amd64.zip",
                "extract_dir": "hydra-$version-windows-amd64"
            },
            "arm64": {
                "url": "https://github.com/ja7ad/hydra/releases/download/v$version/hydra-$version-windows-arm64.zip",
                "extract_dir": "hydra-$version-windows-arm64"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
