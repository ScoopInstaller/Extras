{
    "version": "2026.1.3.2-261.27258.166",
    "description": "Cross-Platform IDE for Data Scientists by JetBrains.",
    "homepage": "https://www.jetbrains.com/dataspell/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.jetbrains.com/store/license.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.jetbrains.com/python/dataspell-2026.1.3.2.exe#/dl.7z",
            "hash": "f5aef42297448b22f95e5af58cc020837cf07dca73d949eae51c26ab9fe72435"
        },
        "arm64": {
            "url": "https://download.jetbrains.com/python/dataspell-2026.1.3.2-aarch64.exe#/dl.7z",
            "hash": "9de574ea73e9ebf5d962b0f9fda31159071c72492edb2377d6224e387021325b"
        }
    },
    "extract_to": "IDE",
    "installer": {
        "script": [
            "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" $dir $persist_dir",
            "Remove-Item \"$dir\\IDE\\`$*\" -Force -Recurse"
        ]
    },
    "shortcuts": [
        [
            "IDE\\bin\\dataspell64.exe",
            "JetBrains\\DataSpell"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\dataspell.exe.vmoptions",
        "IDE\\bin\\dataspell64.exe.vmoptions",
        "profile"
    ],
    "checkver": {
        "url": "https://data.services.jetbrains.com/products/releases?code=DS&latest=true&platform=zip&type=release",
        "regex": "version\":\"(?<ver>[\\d.]+)\".*\"build\":\"(?<build>[\\d.]+)\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.jetbrains.com/python/dataspell-$matchVer.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://download.jetbrains.com/python/dataspell-$matchVer-aarch64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
