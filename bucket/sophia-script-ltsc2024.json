{
    "version": "8.1.0",
    "description": "Sophia Script for Windows (Windows 11 Enterprise LTSC 2024, PowerShell 5.1). The most advanced PowerShell module on GitHub for fine-tuning Windows and automating routine tasks.",
    "homepage": "https://github.com/farag2/Sophia-Script-for-Windows",
    "license": "MIT",
    "notes": [
        "This package provides Sophia Script for Windows 11 Enterprise LTSC 2024, PowerShell 5.1 only.",
        "Other editions: sophia-script, sophia-script-ps7, sophia-script-ltsc2024-ps7, sophia-script-win10, sophia-script-win10-ps7, sophia-script-ltsc2019, sophia-script-ltsc2021."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/farag2/Sophia-Script-for-Windows/releases/download/8.1.0/Sophia.Script.for.Windows.11.LTSC.2024.v8.1.0.zip",
            "hash": "93fa2d6cdc51263d3a61417ec1e77f03ec4b266638cc74926cfb116e3401b962",
            "extract_dir": "Sophia_Script_for_Windows_11_LTSC_2024_v8.1.0"
        }
    },
    "pre_install": [
        "$Build = [int](Get-ItemPropertyValue -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -Name CurrentBuild)",
        "$ProductName = Get-ItemPropertyValue -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -Name ProductName",
        "if (-not (($Build -gt 19045) -and ($ProductName -match 'LTSC 2024'))) {",
        "    $AppDir = Split-Path -Path $dir -Parent",
        "    Remove-Item -LiteralPath $dir -Recurse -Force",
        "    if (-not (Get-ChildItem -LiteralPath $AppDir -Force)) { Remove-Item -LiteralPath $AppDir -Force }",
        "    abort \"This package is for Windows 11 Enterprise LTSC 2024, PowerShell 5.1. Detected: $ProductName (build $Build). Run 'scoop search sophia-script' to pick the right edition.\"",
        "}"
    ],
    "bin": [
        [
            "Sophia.ps1",
            "Sophia"
        ],
        [
            "Sophia.ps1",
            "SophiaScript"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/farag2/Sophia-Script-for-Windows/releases/download/$version/Sophia.Script.for.Windows.11.LTSC.2024.v$version.zip",
                "extract_dir": "Sophia_Script_for_Windows_11_LTSC_2024_v$version"
            }
        }
    }
}
