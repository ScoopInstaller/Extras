    "license": {
        "identifier": "Freeware|Apache-2.0",
        "url": "https://github.com/elastic/kibana/blob/7.2/licenses/ELASTIC-LICENSE.txt"
    },
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://artifacts.elastic.co/downloads/kibana/kibana-9.5.3-windows-x86_64.zip",
            "hash": "sha512:ca32149b3a086c5dc55d671a8291c742fe69b18767f30d679fb9a913485811018fff40f0aeef0eecce853362f0a9c2f4d4011662c4b71def7327735f7513566f",
