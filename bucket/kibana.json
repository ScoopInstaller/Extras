            "url": "https://artifacts.elastic.co/downloads/kibana/kibana-9.5.0-windows-x86_64.zip",
            "hash": "sha512:7d408d12940965dbde5b402ea7041764a7e852f885292f5caf0fb69d532f4550b9ee9ff9e371b43f3fd4ad8ebd848da95c7ae49303217f6a67a68a30e53fb97b",
