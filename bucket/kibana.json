{
    "version": "9.5.7",
    "description": "An open source analytics and visualization platform designed to work with Elasticsearch.",
    "homepage": "https://www.elastic.co/products/kibana",
    "license": {
        "identifier": "Freeware|Apache-2.0",
        "url": "https://github.com/elastic/kibana/blob/7.2/licenses/ELASTIC-LICENSE.txt"
    },
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://artifacts.elastic.co/downloads/kibana/kibana-9.5.7-windows-x86_64.zip",
            "hash": "sha512:ef612c7b9face817b71058f1f7809cdd5518b2b06e5313de41978a54705490c75573c9f7786f207137ab18c902ef34b7438eb76c2f87672003b6de8b04341c57",
