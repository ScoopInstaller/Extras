            "hash": "2c5dcc85b8580ad07a7b7568cb4d5596cf2303c8f3e906aa8139fa51e08c0ee4"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/gvq2u3bwfodszpnu2ihehe4ewm_151.0.7922.170/151.0.7922.170_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "90a4cc64590d665ea6dc248ca03f630875ffb843e1d5bb531599ac6090e0e9bf"
