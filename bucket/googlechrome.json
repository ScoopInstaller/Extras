            "hash": "b1caff7c6044a44c2e3a773bcf91dde93db5f49fd55a54b19c6c1270b9764877"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ovinel3aauublbo5bhqq2bdnom_152.0.7977.76/152.0.7977.76_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "97ccfa48ef495253fc7fbdcf8ba065bc18836cf382802909cc3bb1fa55f54742"
