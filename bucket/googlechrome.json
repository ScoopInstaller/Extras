        "arm64": {
            "url": "https://dl.google.com/release2/chrome/gyazvpafifsf6wmy55lddfyivm_151.0.7922.138/151.0.7922.138_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "049d9c7ac42396c19afb3550ca659724e15fdad87643f788632dd50170b89082"
