{
    "version": "2026.18",
    "description": "Open-source GUI client for git users.",
    "homepage": "https://github.com/sourcegit-scm/sourcegit",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sourcegit-scm/sourcegit/releases/download/v2026.18/sourcegit_2026.18.win-x64.zip",
            "hash": "a50dd63dee892c08c1cec15e397d2fa91aa30c4669ded1910f9a06af0865407a"
        },
        "arm64": {
            "url": "https://github.com/sourcegit-scm/sourcegit/releases/download/v2026.18/sourcegit_2026.18.win-arm64.zip",
            "hash": "3c13038b9dad8e875f800edf39428b0ef4e92488f5a4f34028e7334eb2db3c25"
        }
    },
    "extract_dir": "SourceGit",
    "post_install": [
        "if (Test-Path $env:AppData\\SourceGit) {",
        "    Write-Host \"`r`nMove config from non-portable version...\"",
        "    Copy-Item -Path $env:AppData\\SourceGit\\* -Destination \"$persist_dir\\data\" -Force -Recurse | Out-Null",
        "    Remove-Item $env:AppData\\SourceGit -Force -Recurse",
        "}"
    ],
    "bin": "SourceGit.exe",
    "shortcuts": [
        [
            "SourceGit.exe",
            "SourceGit"
        ]
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sourcegit-scm/sourcegit/releases/download/v$version/sourcegit_$version.win-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/sourcegit-scm/sourcegit/releases/download/v$version/sourcegit_$version.win-arm64.zip"
            }
        }
    }
}
