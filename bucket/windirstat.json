{
    "version": "2.9.3",
    "description": "A disk usage statistics viewer and cleanup tool.",
    "homepage": "https://windirstat.net",
    "license": "GPL-2.0-only",
    "url": "https://github.com/windirstat/windirstat/releases/download/release%2Fv2.9.3/WinDirStat.7z",
    "hash": "e0509718e588ffae76e93f3db6bebaba48b93fa1b9972275de85876229806977",
    "architecture": {
        "64bit": {
            "extract_dir": "x64"
        },
        "32bit": {
            "extract_dir": "x86"
        },
        "arm64": {
            "extract_dir": "arm64"
        }
    },
    "pre_install": [
        "# WinDirStat runs in portable mode only while WinDirStat.ini exists next to the executable,",
        "# so copy the file instead of persisting it, which would always create it.",
        "if (Test-Path \"$persist_dir\\WinDirStat.ini\") { Copy-Item \"$persist_dir\\WinDirStat.ini\" \"$dir\\\" -ErrorAction Stop }"
    ],
    "pre_uninstall": [
        "if (Test-Path \"$dir\\WinDirStat.ini\") {",
        "    ensure $persist_dir | Out-Null",
        "    Copy-Item \"$dir\\WinDirStat.ini\" \"$persist_dir\\\" -Force -ErrorAction Stop",
        "} elseif (Test-Path \"$persist_dir\\WinDirStat.ini\") {",
        "    Remove-Item \"$persist_dir\\WinDirStat.ini\" -Force -ErrorAction Stop",
        "}"
    ],
    "shortcuts": [
        [
            "WinDirStat.exe",
            "WinDirStat"
        ]
    ],
    "checkver": {
        "url": "https://github.com/windirstat/windirstat/releases",
        "regex": "release/v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/windirstat/windirstat/releases/download/release%2Fv$version/WinDirStat.7z",
        "hash": {
            "url": "$baseurl/WinDirStat-Hashes.txt"
        }
    }
}
