{
    "version": "1.10.0",
    "description": "Voice-to-text dictation app with local and cloud models",
    "homepage": "https://openwhispr.com",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/OpenWhispr/openwhispr/releases/download/v1.10.0/OpenWhispr-Setup-1.10.0.exe#/dl.7z",
            "hash": "sha512:281df6267c1acffe6682ff435247b84bf39a6c5807f9601c027ce7fd7ceb4d87e94d17ad559b921340cec7d90132983d15b04fb08157acca79a5360d4580c8d2",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        }
    },
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force",
    "shortcuts": [
        [
            "OpenWhispr.exe",
            "OpenWhispr"
        ]
    ],
    "checkver": {
        "github": "https://github.com/OpenWhispr/openwhispr"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/OpenWhispr/openwhispr/releases/download/v$version/OpenWhispr-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
