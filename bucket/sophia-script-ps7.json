    "pre_install": [
        "$Build = [int](Get-ItemPropertyValue -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -Name CurrentBuild)",
        "$ProductName = Get-ItemPropertyValue -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion' -Name ProductName",
        "if (-not (($Build -gt 19045) -and ($ProductName -notmatch 'LTSC 2024'))) {",
        "    $AppDir = Split-Path -Path $dir -Parent",
        "    Remove-Item -LiteralPath $dir -Recurse -Force",
        "    if (-not (Get-ChildItem -LiteralPath $AppDir -Force)) { Remove-Item -LiteralPath $AppDir -Force }",
        "    abort \"This package is for Windows 11, PowerShell 7. Detected: $ProductName (build $Build). Run 'scoop search sophia-script' to pick the right edition.\"",
        "}",
        "if (-not (Get-Command -Name pwsh -ErrorAction SilentlyContinue)) { warn 'This edition runs on PowerShell 7 only. Install it: scoop install main/pwsh' }"
    ],
    "bin": [
        [
            "Sophia.ps1",
            "Sophia"
        ],
        [
            "Sophia.ps1",
            "SophiaScript"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
