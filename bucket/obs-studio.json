{
    "version": "33.0.3",
    "description": "Video recording and live streaming software",
    "homepage": "https://obsproject.com",
    "license": "GPL-2.0-only",
    "notes": [
        "Add Virtual Camera module by running: \"$dir\\core\\win-dshow\\data\\virtualcam-install.bat\"",
        "Remove it by running: \"$dir\\core\\win-dshow\\data\\virtualcam-uninstall.bat\""
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/obsproject/obs-studio/releases/download/33.0.3/OBS-Studio-33.0.3-Windows-x64.zip",
            "hash": "18a68c325adbda6f6082d5281021a8d1e35a6432842800618e8690b71925c107",
            "shortcuts": [
                [
                    "bin\\64bit\\obs64.exe",
                    "OBS Studio"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/obsproject/obs-studio/releases/download/33.0.3/OBS-Studio-33.0.3-Windows-arm64.zip",
            "hash": "be4796536a182f2c04c719b6edd7aa704ea4c083d5e511913d380ccfea00facf",
            "shortcuts": [
                [
                    "bin\\64bit\\obs64.exe",
                    "OBS Studio"
                ]
            ]
        }
    },
    "pre_install": [
        "if (-not (Test-Path \"$persist_dir\\portable_mode.txt\")) {",
        "    New-Item -Path \"$dir\\portable_mode.txt\" -ItemType File -Force | Out-Null",
        "}"
    ],
    "post_install": [
        "'data', 'obs-plugins' | ForEach-Object {",
        "    $source_dir = Join-Path $dir \"$_.original\"",
        "    $destination_dir = Join-Path $dir $_",
        "    if (Test-Path \"$source_dir\") {",
        "        Copy-Item -Path \"$source_dir\\*\" -Destination $destination_dir -Force -Recurse",
        "        Remove-Item -Path $source_dir -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "persist": [
        "data",
        "config",
        "obs-plugins",
        "portable_mode.txt"
    ],
    "checkver": {
        "github": "https://github.com/obsproject/obs-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/obsproject/obs-studio/releases/download/$version/OBS-Studio-$version-Windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/obsproject/obs-studio/releases/download/$version/OBS-Studio-$version-Windows-arm64.zip"
            }
        },
        "hash": {
            "url": "https://github.com/obsproject/obs-studio/releases/$version",
            "regex": "(?sm)$basename.*?$sha256"
        }
    }
}
