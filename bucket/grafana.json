        [
            "bin\\grafana.exe",
            "grafana-cli",
            "cli"
        ],
        [
            "bin\\grafana.exe",
            "grafana-server",
            "server -homepath \"$dir\""
        ]
    ],
    "persist": [
        "conf",
        "data"
    ],
    "checkver": {
        "url": "https://grafana.com/grafana/download?edition=oss&platform=windows",
