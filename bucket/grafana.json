    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://dl.grafana.com/oss/release/grafana-13.1.3.windows-amd64.zip",
            "hash": "9d0038e110916dc4ff8edc646c27ba46cf71ee68476455b09226de4d21c4f0c9"
        },
        "arm64": {
            "url": "https://dl.grafana.com/oss/release/grafana-13.1.3.windows-arm64.zip",
            "hash": "cfab13cfbf250314330c7406e932c28f20fc6ebb5cef3629294728d5355080c1"
        }
    },
    "extract_dir": "grafana-13.1.3",
    "bin": [
        "bin\\grafana.exe",
        [
            "bin\\grafana.exe",
            "grafana-cli",
            "cli"
        ],
        [
            "bin\\grafana.exe",
            "grafana-server",
            "server -homepath \"$dir\""
        ]
    ],
    "persist": [
        "conf",
        "data"
    ],
    "checkver": {
        "url": "https://grafana.com/grafana/download?edition=oss&platform=windows",
        "regex": "grafana_([\\d.]+(?:\\+security-\\d+)?)_(?<stamp>[\\d]+)_windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.grafana.com/oss/release/grafana-$version.windows-amd64.zip"
            },
            "arm64": {
                "url": "https://dl.grafana.com/oss/release/grafana-$version.windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        },
        "extract_dir": "grafana-$version"
    }
}
