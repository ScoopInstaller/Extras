            "hash": "a5e6fa38c86f44af466f0361ad516651663dd0f3574d771e1c031978c91f69dd"
        },
        "arm64": {
            "url": "https://dl.grafana.com/oss/release/grafana-13.3.1.windows-arm64.zip",
            "hash": "88f0a6ba1c6cfe0eec80224edd48bcd11f14aa294d7cf90a2d714cdab7c7e6e5"
        }
    },
    "extract_dir": "grafana-13.3.1",
    "bin": [
        "bin\\grafana.exe",
        [
            "bin\\grafana.exe",
            "grafana-cli",
            "cli"
        ],
        [
            "bin\\grafana.exe",
            "grafana-server",
            "server -homepath \"$dir\""
        ]
    ],
    "persist": [
        "conf",
        "data"
    ],
    "checkver": {
        "url": "https://grafana.com/grafana/download?edition=oss&platform=windows",
        "regex": "grafana_([\\d.]+(?:\\+security-\\d+)?)_(?<stamp>[\\d]+)_windows"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.grafana.com/oss/release/grafana-$version.windows-amd64.zip"
            },
            "arm64": {
                "url": "https://dl.grafana.com/oss/release/grafana-$version.windows-arm64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        },
        "extract_dir": "grafana-$version"
    }
}
