{
    "version": "26.4.2",
    "description": "A fast, lightweight and extensible text editor for Windows. Useful for opening very large files.",
    "homepage": "https://www.emeditor.com/",
    "license": "Shareware",
    "architecture": {
        "64bit": {
            "url": "https://download.emeditor.com/emed64_26.4.2_portable.zip",
            "hash": "65fc522a1683d8b7287b336d8baee7cf87e8f9c7e72a3e1beda686235ba4b2e2"
        }
    },
    "pre_install": [
        "$manifest.persist | ForEach-Object {",
        "    if ([io.path]::GetExtension($_)) {",
        "        if (!(Test-Path \"$persist_dir\\$_\")) { New-Item \"$dir\\$_\" | Out-Null }",
        "    }",
        "}"
    ],
    "bin": "EmEditor.exe",
    "shortcuts": [
        [
            "EmEditor.exe",
            "EmEditor"
        ]
    ],
    "persist": [
        "AppData",
        "eeCommon.ini",
        "eeConfig.ini",
        "eeLM.ini",
        "eePlugins.ini"
    ],
    "checkver": {
        "script": [
            "$request = [System.Net.HttpWebRequest]::Create('https://support.emeditor.com/en/downloads/latest/portable')",
            "$request.Method = 'HEAD'",
            "$response = $request.GetResponse()",
            "Write-Output $response.ResponseUri.AbsoluteUri",
            "$response.Close()"
        ],
        "regex": "emed64_([\\d.]+)_portable\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.emeditor.com/emed64_$version_portable.zip"
            }
        }
    }
}
