{
    "version": "2.5.0",
    "description": "A free, open-source file converter you use by dragging.",
    "homepage": "https://filee.sh",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KnifeLemon/Filee/releases/download/v2.5.0/Filee-2.5.0-win-Portable.zip",
            "hash": "a0e6c5f6b623f100c6ed6d4afae96f6efbee6c6e1ad790fe3e789fa4a9bfdf4f"
        },
        "arm64": {
            "url": "https://github.com/KnifeLemon/Filee/releases/download/v2.5.0/Filee-2.5.0-win-arm64-Portable.zip",
            "hash": "d0ffbdf0e8c07838866dd5f13e8e4dfd9b94308c48edb6016f93a6c7744833fb"
        }
    },
    "post_install": [
        "if ((Test-Path \"$env:APPDATA\\Filee\\*\") -and (-not (Test-Path \"$persist_dir\\data\\*\"))) {",
        "    Write-Host \"`r`nMove app data from non-portable version...\"",
        "    Copy-Item -Path \"$env:APPDATA\\Filee\\*\" -Destination \"$persist_dir\\data\" -Force -Recurse -ErrorAction Stop | Out-Null",
        "    Remove-Item $env:APPDATA\\Filee -Force -Recurse",
        "}"
    ],
    "bin": "cli\\filee.cmd",
    "shortcuts": [
        [
            "Filee.exe",
            "Filee"
        ]
    ],
    "persist": "data",
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    Remove-Item -LiteralPath 'HKCU:\\Software\\Classes\\*\\shell\\Filee' -Recurse -Force -ErrorAction SilentlyContinue",
        "    Get-AppxPackage -Name 'Filee.ExplorerMenu' | Remove-AppxPackage -ErrorAction SilentlyContinue",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/KnifeLemon/Filee"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KnifeLemon/Filee/releases/download/v$version/Filee-$version-win-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/KnifeLemon/Filee/releases/download/v$version/Filee-$version-win-arm64-Portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/Filee-$version-SHA256SUMS.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
