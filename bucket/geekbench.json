{
    "version": "7.1.0",
    "description": "CPU/GPU benchmark software",
    "homepage": "https://www.geekbench.com/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.primatelabs.com/legal/eula-v5.html"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022",
        "Microsoft Edge WebView2": "extras/webview2"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn.geekbench.com/Geekbench-7.1.0-WindowsSetup.exe",
            "hash": "0a388e786de3978d57e28561fee4e1703c312853faaf79dcc8690cc225885669",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\$fname\" -Overwrite Skip -Removal",
                "Remove-Item \"$dir\\*aarch64*\" -ErrorAction Ignore"
            ]
        },
        "arm64": {
            "url": "https://cdn.geekbench.com/Geekbench-7.1.0-WindowsSetup.exe",
            "hash": "0a388e786de3978d57e28561fee4e1703c312853faaf79dcc8690cc225885669",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\$fname\" -Overwrite All -Removal",
                "Remove-Item \"$dir\\*x86_64*\", \"$dir\\*x64*\", \"$dir\\*avx2*\", \"$dir\\cpuidsdk64.dll\" -ErrorAction Ignore"
            ]
        }
    },
    "installer": {
        "script": [
            "Move-Item \"$dir\\geekbench ?.exe\" \"$dir\\geekbench_gui.exe\"",
            "Move-Item \"$dir\\geekbench?.exe\" \"$dir\\geekbench.exe\"",
            "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\", \"$dir\\vc_redist*.exe\" -Recurse"
        ]
    },
    "bin": "geekbench.exe",
    "shortcuts": [
        [
            "geekbench_gui.exe",
            "GeekBench"
        ]
    ],
    "checkver": {
        "url": "https://www.geekbench.com/download/windows/",
        "regex": "Geekbench-([\\d.]+)-WindowsSetup\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.geekbench.com/Geekbench-$version-WindowsSetup.exe"
            },
            "arm64": {
                "url": "https://cdn.geekbench.com/Geekbench-$version-WindowsSetup.exe"
            }
        }
    }
}
