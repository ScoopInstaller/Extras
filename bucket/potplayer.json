    "pre_install": [
        "Remove-Item -Path \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse -Force -ErrorAction SilentlyContinue",
        "$cfg = @(",
        "    '[Settings]'",
        "    'AutoUpdateStart=0'",
        "    'CheckAutoUpdate=0'",
        "    'FastAutoUpdate=0'",
        ")",
        "# Disable automatic updates for all PotPlayer executables",
        "'PotPlayer.ini', 'PotPlayer64.ini', 'PotPlayerMini.ini', 'PotPlayerMini64.ini' | ForEach-Object {",
        "    if (-not (Test-Path \"$persist_dir\\$_\")) {",
        "        info \"File $_ does not exist. Creating...\"",
        "        Set-Content -Path \"$dir\\$_\" -Value $cfg -Encoding Ascii",
        "    }",
        "}"
    ],
    "post_install": [
        "'Logos', 'Skins', 'Module', 'UrlList', 'IconPack', 'PxShader','Extension' | ForEach-Object {",
        "    $source_dir = Join-Path $dir \"$_.original\"",
        "    $destination_dir = Join-Path $dir $_",
        "    if (Test-Path \"$source_dir\") {",
        "        Copy-Item -Path \"$source_dir\\*\" -Destination $destination_dir -Force -Recurse",
        "        Remove-Item -Path $source_dir -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "persist": [
        "Logos",
        "Model",
        "Skins",
        "Engine",
        "Module",
        "Capture",
        "Playlist",
        "UrlList",
        "IconPack",
        "PxShader",
        "Extension",
        "Extention",
        "PotPlayer.ini",
        "PotPlayer64.ini",
        "PotPlayerMini.ini",
        "PotPlayerMini64.ini"
    ],
    "checkver": {
        "url": "https://t1.daumcdn.net/potplayer/PotPlayer/v4/Update2/UpdateEng.html",
        "script": [
            "$date = if ($page -match '\\[(\\d+)\\]') { $Matches[1] } else { '' }",
            "if ($date.Length -eq 0) { error 'Failed to extract date from page'; return '' }",
            "$tempFile = New-TemporaryFile",
            "$wc = [System.Net.HttpWebRequest]::Create(\"https://t1.daumcdn.net/potplayer/PotPlayer/Version/$date/PotPlayerSetup64.exe\")",
            "$wc.AddRange(0, 1000000)",
            "$out = $tempFile.OpenWrite()",
            "$wc.GetResponse().GetResponseStream().CopyTo($out)",
            "$out.Close()",
            "$versionInfo = (Get-Item $tempFile.FullName).VersionInfo",
            "Remove-Item $tempFile.FullName -Force -ErrorAction Ignore",
            "return \"$date-$($versionInfo.ProductVersion)\""
        ],
        "regex": "(\\d+-\\d+(?:\\.\\d+)+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://t1.daumcdn.net/potplayer/PotPlayer/Version/$majorVersion/PotPlayerSetup64.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://t1.daumcdn.net/potplayer/PotPlayer/Version/$majorVersion/PotPlayerSetup.exe#/dl.7z"
