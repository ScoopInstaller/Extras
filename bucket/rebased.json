{
    "version": "1.1.20",
    "description": "An open-source remake of the short-lived JetBrains git client.",
    "homepage": "https://github.com/DetachHead/rebased",
    "license": {
        "identifier": "Apache-2.0",
        "url": "https://github.com/DetachHead/rebased/blob/master/LICENSE.txt"
    },
    "notes": [
        "To add Rebased to right-click context menu, run:",
        "reg import \"$dir\\install-context.reg\""
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/DetachHead/rebased/releases/download/1.1.20/rebased.win.zip",
            "hash": "0b6e8940f5caa4e2b0edf33979dabeb19f17b8d49291d559a31c37f5b3ae3cfa"
        },
        "arm64": {
            "url": "https://github.com/DetachHead/rebased/releases/download/1.1.20/rebased-aarch64.win.zip",
            "hash": "117381a6534b99185396179407d079a94460792f74c92245e070d4b859b6cb35"
        }
    },
    "extract_to": "IDE",
    "installer": {
        "script": "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" \"$dir\" \"$persist_dir\""
    },
    "post_install": [
        "$app_path = \"$dir\\IDE\\bin\\rebased64.exe\".Replace('\\', '\\\\')",
        "'install-context', 'uninstall-context' | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\extras\\scripts\\$app\\$_.reg\") {",
        "        $content = (Get-Content \"$bucketsdir\\extras\\scripts\\$app\\$_.reg\" -Encoding UTF8).Replace('$app_path', $app_path)",
        "        if ($global) { $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE') }",
        "        Set-Content \"$dir\\$_.reg\" $content -Encoding Unicode -Force",
        "    }",
        "}"
    ],
    "bin": [
        [
            "IDE\\bin\\rebased64.exe",
            "rebased"
        ]
    ],
    "shortcuts": [
        [
            "IDE\\bin\\rebased64.exe",
            "Rebased"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\rebased64.exe.vmoptions",
        "profile"
    ],
    "uninstaller": {
        "script": "if ($cmd -eq 'uninstall') { reg import \"$dir\\uninstall-context.reg\" }"
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/DetachHead/rebased/releases/download/$version/rebased.win.zip"
            },
            "arm64": {
                "url": "https://github.com/DetachHead/rebased/releases/download/$version/rebased-aarch64.win.zip"
            }
        }
    }
}
