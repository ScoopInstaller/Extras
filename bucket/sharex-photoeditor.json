{
    "version": "22.4.0-photoeditor.1",
    "description": "Standalone PhotoEditor build forked from ShareX",
    "homepage": "https://github.com/windedge/ShareX.PhotoEditor",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/windedge/ShareX.PhotoEditor/releases/download/v22.4.0-photoeditor.1/ShareX.PhotoEditor-setup-x64.exe",
            "hash": "be8f050436f3fa0b23c89a95872bef39c28002b4b36c9654004d9d00a310a603"
        }
    },
    "innosetup": true,
    "bin": "ShareX.PhotoEditor-win-x64.exe",
    "shortcuts": [
        [
            "ShareX.PhotoEditor-win-x64.exe",
            "ShareX PhotoEditor"
        ]
    ],
    "notes": [
        "Settings are stored in %USERPROFILE%\\Documents\\ShareX\\PhotoEditor.App.json (outside the Scoop directory, so they are not removed on uninstall).",
        "This standalone build omits ShareX upload, post-capture tasks, pin to screen, print, region capture and fullscreen capture."
    ],
    "checkver": {
        "github": "https://github.com/windedge/ShareX.PhotoEditor",
        "regex": "/releases/tag/v([\\w.\\-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/windedge/ShareX.PhotoEditor/releases/download/v$version/ShareX.PhotoEditor-setup-x64.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "find": "$basename"
        }
    }
}
