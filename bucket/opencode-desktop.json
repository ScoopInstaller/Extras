    "notes": [
        "For OpenCode v1 Desktop, please install 'versions/opencode1-desktop'",
        "The v2 configuration is incompatible with v1.",
        "See https://opencode.ai/docs/migrate-v1/ for migration steps."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/anomalyco/opencode/releases/download/v2.4.0/opencode-desktop-win-x64.exe#/dl.7z",
            "hash": "10e2c9beba8a8607c9a1bdf10ef4d3e81814dcb6159233f262c1b325980d56c0"
        },
        "arm64": {
            "url": "https://github.com/anomalyco/opencode/releases/download/v2.4.0/opencode-desktop-win-arm64.exe#/dl.7z",
            "hash": "e1cdd816725f5e98d8fb1815a8e15f83b05376384f8f2ddf069128383427f78e"
        }
    },
    "pre_install": [
        "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-*.7z\" \"$dir\"",
        "& \"$env:SystemRoot\\System32\\icacls.exe\" \"$dir\" /grant '*S-1-15-2-2:(OI)(CI)(RX)'",
        "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse -ErrorAction Ignore"
    ],
    "shortcuts": [
        [
            "OpenCode.exe",
            "OpenCode"
        ]
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@opencode/cli/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/anomalyco/opencode/releases/download/v$version/opencode-desktop-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/anomalyco/opencode/releases/download/v$version/opencode-desktop-win-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
