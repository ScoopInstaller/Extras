        "   'set \"ANKI_LAUNCHER=%USB_ROOT%\\anki\"'",
        "   'set \"ANKI_BASE=%USB_ROOT%\\data\"'",
        "   'start /b \"\" \"%ANKI_LAUNCHER%\"'",
        ") | Set-Content \"$dir\\anki.cmd\" -Encoding ASCII"
