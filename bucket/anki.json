    "checkver": {
        "github": "https://api.github.com/repos/ankitects/anki/releases",
        "jsonpath": "$[*].assets[*].browser_download_url",
        "regex": "download/(?<version>[\\d.]+)/anki-\\k<version>-win-x64\\.msi"
