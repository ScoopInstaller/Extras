{
    "version": "3.70.2",
    "description": "Lossless trimming tool for video and audio files",
    "homepage": "https://losslesscut.app/",
    "license": "GPL-2.0-only",
    "notes": [
        "For .mp4 and .mkv file associations, run:",
        "reg import \"$dir\\install-associations.reg\""
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/mifi/lossless-cut/releases/download/v3.70.2/LosslessCut-win-x64.7z",
            "hash": "1740c5f17b952c04cf1b1612cf32f56c68a88105c045199526c7ea9678d309b0"
        },
        "arm64": {
            "url": "https://github.com/mifi/lossless-cut/releases/download/v3.70.2/LosslessCut-win-arm64.7z",
            "hash": "83ff5e154f5e9662cee7a4f92f1e8fa2a1829208640bf43df5c9bfdae37e14d5"
        }
    },
    "post_install": [
        "$dirpath = \"$dir\".Replace('\\', '\\\\')",
        "'install-associations', 'uninstall-associations' | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\extras\\scripts\\losslesscut\\$_.reg\") {",
        "        $content = Get-Content \"$bucketsdir\\extras\\scripts\\losslesscut\\$_.reg\"",
        "        $content = $content.Replace('$dirpath', $dirpath)",
        "        if ($global) { $content = $content -replace 'HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE' }",
        "        $content | Set-Content -Path \"$dir\\$_.reg\"",
        "    }",
        "}"
    ],
    "bin": "LosslessCut.exe",
    "shortcuts": [
        [
            "LosslessCut.exe",
            "LosslessCut"
        ]
    ],
    "uninstaller": {
        "script": "if ($cmd -eq 'uninstall') { reg import \"$dir\\uninstall-associations.reg\" *> $null }"
    },
    "checkver": {
        "github": "https://github.com/mifi/lossless-cut"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mifi/lossless-cut/releases/download/v$version/LosslessCut-win-x64.7z"
            },
            "arm64": {
                "url": "https://github.com/mifi/lossless-cut/releases/download/v$version/LosslessCut-win-arm64.7z"
            }
        }
    }
}
