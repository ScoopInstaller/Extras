{
    "version": "2026.2.4",
    "description": "Cross-Platform IDE for Python by JetBrains (Open Source Community Edition).",
    "homepage": "https://github.com/JetBrains/intellij-community",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm/2026.2.4/pycharm-2026.2.4.win.zip",
            "hash": "2ce1562d1fd102f4df120d74259c3fd34d5f49787b46c855f21955cfb3247ea1",
            "bin": [
                [
                    "IDE\\bin\\pycharm64.exe",
                    "pycharm"
                ]
            ],
            "shortcuts": [
                [
                    "IDE\\bin\\pycharm64.exe",
                    "JetBrains\\PyCharm (Community Edition)"
                ]
            ]
        },
        "arm64": {
            "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm/2026.2.4/pycharm-2026.2.4-aarch64.win.zip",
            "hash": "ddadccecfc19660bbe13cd4d47911135beefdfa4b9d2518c34ddaf789bb63ec8",
            "bin": [
                [
                    "IDE\\bin\\pycharm64.exe",
                    "pycharm"
                ]
            ],
            "shortcuts": [
                [
                    "IDE\\bin\\pycharm64.exe",
                    "JetBrains\\PyCharm (Community Edition)"
                ]
            ]
        }
    },
    "extract_to": "IDE",
    "installer": {
        "script": "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" \"$dir\" \"$persist_dir\""
    },
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\pycharm64.exe.vmoptions",
        "profile"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/JetBrains/intellij-community/releases",
        "script": [
            "$releases = $page | ConvertFrom-Json -ErrorAction Stop",
            "$versions = $releases | Where-Object { $_.tag_name -match '^pycharm/(?<version>[\\d.]+)$' } | ForEach-Object { [version]$Matches['version'] }",
            "$latest_version = $versions | Sort-Object -Descending | Select-Object -First 1",
            "Write-Output \"$($latest_version.ToString())\""
        ],
        "regex": "^(?<version>[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm/$version/pycharm-$version.win.zip"
            },
            "arm64": {
                "url": "https://github.com/JetBrains/intellij-community/releases/download/pycharm/$version/pycharm-$version-aarch64.win.zip"
            }
        }
    }
}
