{
    "version": "3.4.0",
    "description": "A web file server to run on your computer",
    "homepage": "https://rejetto.com/hfs",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/rejetto/hfs/releases/download/v3.4.0/hfs-windows-x64-3.4.0.zip",
            "hash": "8e68f5df65d0fb872bbcfe3a9b38f3fb6b11e613c52ddd9cc3493ee4fa883743"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\config.yaml\")) { New-Item \"$dir\\config.yaml\" | Out-Null }",
    "bin": [
        [
            "hfs.exe",
            "hfs",
            "--cwd $dir"
        ]
    ],
    "shortcuts": [
        [
            "hfs.exe",
            "HFS",
            "--cwd $dir"
        ]
    ],
    "persist": [
        "config.yaml",
        "logs",
        "plugins"
    ],
    "checkver": {
        "github": "https://github.com/rejetto/hfs"
    },
    "autoupdate": {
        "url": "https://github.com/rejetto/hfs/releases/download/v$version/hfs-windows-x64-$version.zip"
    }
}
