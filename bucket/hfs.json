{
    "version": "3.3.4",
    "description": "A web file server to run on your computer",
    "homepage": "https://rejetto.com/hfs",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/rejetto/hfs/releases/download/v3.3.4/hfs-windows-x64-3.3.4.zip",
            "hash": "4b7b46487f58b7a7a06d361a60af4961dfb6a4a1999d2edb3662c94f9852675a"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\config.yaml\")) { New-Item \"$dir\\config.yaml\" | Out-Null }",
    "bin": [
        [
            "hfs.exe",
            "hfs",
            "--cwd $dir"
        ]
    ],
    "shortcuts": [
        [
            "hfs.exe",
            "HFS",
            "--cwd $dir"
        ]
    ],
    "persist": [
        "config.yaml",
        "logs",
        "plugins"
    ],
    "checkver": {
        "github": "https://github.com/rejetto/hfs"
    },
    "autoupdate": {
        "url": "https://github.com/rejetto/hfs/releases/download/v$version/hfs-windows-x64-$version.zip"
    }
}
