{
    "version": "0.2.0",
    "description": "Windows file-copy utility that verifies every file and never lets one failure abort the batch",
    "homepage": "https://github.com/yunicopy/yunicopy",
    "license": "MIT|Apache-2.0",
    "notes": [
        "Scoop installs the portable build: settings and logs stay inside the app directory",
        "(the yunicopy.portable marker file). 'yunicopy' is the console tool; the window is",
        "available as the 'YuniCopy' shortcut or via 'yunicopy-gui'.",
        "Optional Explorer right-click integration: yunicopy-gui --install-shell",
        "(and yunicopy-gui --uninstall-shell before 'scoop uninstall yunicopy').",
        "Settings, saved jobs and logs are kept in the persist folder, so 'scoop update' does not lose them."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/yunicopy/yunicopy/releases/download/v0.2.0/YuniCopy-0.2.0-x64-portable.zip",
            "hash": "dc2a66a8848028d07d31c8b6136ede566c51e814caea08009d55b2299d8754aa"
        },
        "arm64": {
            "url": "https://github.com/yunicopy/yunicopy/releases/download/v0.2.0/YuniCopy-0.2.0-arm64-portable.zip",
            "hash": "fa637eea279e2edea84f592540b225cd0f5ad2ba1865e9b8ccc0ec7f76f1f04b"
        }
    },
    "bin": [
        "yunicopy.exe",
        "yunicopy-gui.exe"
    ],
    "shortcuts": [
        [
            "yunicopy-gui.exe",
            "YuniCopy"
        ]
    ],
    "persist": [
        "yunicopy.portable",
        "settings.conf",
        "history.log",
        "jobs",
        "logs"
    ],
    "checkver": {
        "github": "https://github.com/yunicopy/yunicopy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/yunicopy/yunicopy/releases/download/v$version/YuniCopy-$version-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/yunicopy/yunicopy/releases/download/v$version/YuniCopy-$version-arm64-portable.zip"
            }
        },
        "hash": {
            "url": "https://github.com/yunicopy/yunicopy/releases/download/v$version/SHA256SUMS.txt"
        }
    }
}
