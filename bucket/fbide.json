{
    "version": "0.5.2",
    "description": "#1 editor for FreeBASIC",
    "homepage": "https://fbide.freebasic.net",
    "license": "MIT",
    "depends": "freebasic",
    "architecture": {
        "64bit": {
            "url": "https://github.com/albeva/fbide/releases/download/v0.5.2/fbide-0.5.2-win64.zip",
            "hash": "8f7ec456fc8111892832e17b17801e4f9de393d2837ea5a3492517458b159ef7"
        },
        "32bit": {
            "url": "https://github.com/albeva/fbide/releases/download/v0.5.2/fbide-0.5.2-win32.zip",
            "hash": "d99868ae783fb4bfc7a02e3a4e39468faf2e8688055572a77afbfd51bc3095fd"
        },
        "arm64": {
            "url": "https://github.com/albeva/fbide/releases/download/v0.5.2/fbide-0.5.2-winarm64.zip",
            "hash": "692694c39f409299ff389608e0dff81cdc88d22272aa21350b1268645ca730e9"
        }
    },
    "pre_install": [
        "# create placeholders for user-local files",
        "$base = @('config_win', 'history', 'layout', 'keywords', 'shortcuts_win')",
        "foreach ($name in $base) {",
        "    $fname = \"$name.local.ini\"",
        "    if (!(Test-Path \"$persist_dir\\ide\\$fname\")) { New-Item \"$dir\\ide\\$fname\" -ItemType 'File' | Out-Null }",
        "}",
        "if (!(Test-Path \"$persist_dir\\ide\\config_win.ini\")) {",
        "   $fbc = (versiondir 'freebasic' 'current') -replace '\\\\', '\\\\'",
        "   $content = Get-Content \"$dir\\ide\\config_win.ini\" -Raw",
        "   $content = $content -replace 'path=', \"path=$fbc\\\\fbc.exe\"",
        "   $content = $content -replace 'checkOnStartup=1', 'checkOnStartup=0'",
        "   Set-Content \"$dir\\ide\\config_win.ini\" $content -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "fbide.exe",
            "FBIde"
        ]
    ],
    "persist": [
        "ide\\themes",
        "ide\\config_win.ini",
        "ide\\config_win.local.ini",
        "ide\\history.local.ini",
        "ide\\layout.ini",
        "ide\\layout.local.ini",
        "ide\\keywords.ini",
        "ide\\keywords.local.ini",
        "ide\\shortcuts_win.ini",
        "ide\\shortcuts_win.local.ini"
    ],
    "checkver": {
        "github": "https://github.com/albeva/fbide"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/albeva/fbide/releases/download/v$version/fbide-$version-win64.zip"
            },
            "32bit": {
                "url": "https://github.com/albeva/fbide/releases/download/v$version/fbide-$version-win32.zip"
            },
            "arm64": {
                "url": "https://github.com/albeva/fbide/releases/download/v$version/fbide-$version-winarm64.zip"
            }
        }
    }
}
