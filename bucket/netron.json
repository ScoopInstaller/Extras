            ]
        }
    },
    "bin": "Netron.exe",
    "shortcuts": [
        [
            "Netron.exe",
            "Netron"
        ]
    ],
    "checkver": {
        "github": "https://github.com/lutzroeder/netron"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/lutzroeder/netron/releases/download/v$version/Netron-Setup-$version.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s+$base64"
                }
            }
        }
    }
}
