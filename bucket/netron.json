{
    "version": "9.3.7",
    "description": "Visualizer for deep learning and machine learning models",
    "homepage": "https://netron.app/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/lutzroeder/netron/releases/download/v9.3.7/Netron-Setup-9.3.7.exe#/dl.7z",
            "hash": "sha512:a5e838edf7ac7a3ea20ccc4cd56091cf8d614f17faeeaf332b33488edc0fd1f8e15ef1ce719e2db3e9f86bd1319a11d2f839bba87d7fe12abded28fb193b3d8e",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
