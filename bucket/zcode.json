{
    "version": "3.14.4",
    "description": "A full-featured Agentic Development Environment (ADE) built for Long Horizon Tasks, powered by Z.ai.",
    "homepage": "https://zcode.z.ai/en",
    "license": {
        "identifier": "Proprietary",
        "url": "https://zcode.z.ai/en/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn-zcode.z.ai/zcode/electron/releases/3.14.4/windows-x64/ZCode-3.14.4-win-x64.exe#/dl.7z",
            "hash": "52972d6ac1aa189f0b89163c76ab6963814b45eb256a151b2ed04f32546e256b"
        },
        "arm64": {
            "url": "https://cdn-zcode.z.ai/zcode/electron/releases/3.14.4/windows-arm64/ZCode-3.14.4-win-arm64.exe#/dl.7z",
            "hash": "e349e6db9cf9dd10e3e7bc0861c65dddcc08df2e25cd2e7e117a91425030e2ca"
        }
    },
    "installer": {
        "script": [
            "Get-Item -Path \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "Remove-Item -Path \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force"
        ]
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "shortcuts": [
        [
            "ZCode.exe",
            "ZCode"
        ]
    ],
    "checkver": {
        "regex": "ZCode-(?<version>\\d+(?:\\.\\d+)+)-win-x64\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn-zcode.z.ai/zcode/electron/releases/$version/windows-x64/ZCode-$version-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://cdn-zcode.z.ai/zcode/electron/releases/$version/windows-arm64/ZCode-$version-win-arm64.exe#/dl.7z"
            }
        }
    }
}
