            "hash": "sha512:56bc355636dca1c7e03843cf7d765c2a7228ede38cc89a55da288970bd615a6171b90b14aa031c269287846ef158e151aed98f6754a00799d88b01b8b3342d1a",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
