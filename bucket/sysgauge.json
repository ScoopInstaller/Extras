    "installer": {
        "script": [
            "Rename-Item \"$dir\\bin\\sysgauge.flx\" 'sysgau.flx'",
            "Invoke-ExternalCommand \"$dir\\bin\\dsminst.exe\" 'install', \"$dir\", 'sysgau' -LogPath \"$dir\\dsminst.log\" | Out-Null",
