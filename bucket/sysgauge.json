    },
    "shortcuts": [
        [
            "bin\\sysgau.exe",
            "SysGauge"
        ]
    ],
    "checkver": {
        "url": "https://www.sysgauge.com/downloads.html",
        "regex": "(?sm)>SysGauge.*?>([\\d.]+)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://www.sysgauge.com/setups_x64/sysgauge_setup_v$version_x64.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://www.sysgauge.com/setups/sysgauge_setup_v$version.exe#/dl.7z"
