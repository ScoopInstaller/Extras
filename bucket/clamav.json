                "extract_dir": "clamav-$version.win.win32"
            },
            "arm64": {
                "url": "https://github.com/Cisco-Talos/clamav/releases/download/clamav-$version/clamav-$version.win.arm64.zip",
                "extract_dir": "clamav-$version.win.arm64"
            }
        }
    }
