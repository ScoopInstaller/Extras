            "hash": "68124557ae03a28e5669ad4c62eb2c8a1771740d8a7866385d2cf3a33b379614"
        },
        "32bit": {
            "url": "https://downloads.vivaldi.com/stable/Vivaldi.8.2.4133.52.exe#/dl.7z",
            "hash": "1d100598b342e3d1981cf9b030ca353183cfa389adf3863955dc8b60f7905601"
        },
        "arm64": {
            "url": "https://downloads.vivaldi.com/stable/Vivaldi.8.2.4133.52.arm64.exe#/dl.7z",
