{
    "version": "1.34.84",
    "description": "Fast, lightweight, advanced system information tool for your PC.",
    "homepage": "https://www.ccleaner.com/speccy",
    "license": "Freeware",
    "url": "https://download.ccleaner.com/spsetup134.exe",
    "hash": "a7f525daeb124f90d2a07d2975f40b9ee568d56244902d3418728ce6dfd737f0",
    "architecture": {
        "32bit": {
            "pre_install": [
                "Expand-7zipArchive \"$dir\\$fname\" -Overwrite All -Removal",
                "Get-ChildItem -LiteralPath $dir -Filter 'Speccy.exe' -Recurse -File | Move-Item -Destination \"$dir\\Speccy.exe\" -Force"
            ]
        },
        "64bit": {
            "pre_install": [
                "Expand-7zipArchive \"$dir\\$fname\" -Overwrite Skip -Removal",
                "Get-ChildItem -LiteralPath $dir -Filter 'Speccy64.exe' -Recurse -File | Move-Item -Destination \"$dir\\Speccy.exe\" -Force"
            ]
        }
    },
    "installer": {
        "script": [
            "Get-ChildItem -Path \"$dir\" -Exclude 'Speccy.exe', 'Lang', 'cpuidsdk.dll' | Remove-Item -Recurse -Force",
            "Set-Content -Path \"$dir\\portable.dat\" -Value '#PORTABLE#' -Encoding ASCII",
            "if (-not (Test-Path \"$persist_dir\\Speccy.ini\")) {",
            "    Set-Content \"$dir\\Speccy.ini\" (@('[Software\\Piriform\\Speccy]', 'NeedUpdate=0') -join \"`r`n\") -Encoding ASCII",
            "}"
        ]
    },
    "bin": "Speccy.exe",
    "shortcuts": [
        [
            "Speccy.exe",
            "speccy"
        ]
    ],
    "persist": "Speccy.ini",
    "checkver": {
        "useragent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36",
        "url": "https://www.ccleaner.com/speccy/version-history",
        "regex": ">v([\\d.]+)<"
    },
    "autoupdate": {
        "url": "https://download.ccleaner.com/spsetup$majorVersion$minorVersion.exe"
    }
}
