{
    "version": "5.37.0.3866",
    "description": "Client for Amazon workspaces service",
    "homepage": "https://clients.amazonworkspaces.com",
    "license": {
        "identifier": "Proprietary",
        "url": "https://clients.amazonworkspaces.com/app-terms.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://d2td7dqidlhjx7.cloudfront.net/prod/global/windows/Amazon+WorkSpaces.msi",
            "hash": "9daaa754d7393cf528dc540a97fa035cfc6c997a6f3a57df62e05bb38a398a0c"
        }
    },
    "extract_dir": "[ApplicationFolderName]",
    "pre_install": [
        "# Disable the autoupdate of amazon-workspaces client",
        "$configFile = \"$dir\\workspaces.dll.config\"",
        "if (Test-Path -LiteralPath $configFile) {",
        "   [xml]$xml = Get-Content -LiteralPath $configFile",
        "   $key = $xml.SelectSingleNode(\"(//configuration/appSettings/add[@key='UpdateUrl'])[1]\")",
        "   $key.Value = ''",
        "   $xml.Save($configFile)",
        "}",
        "# Run bundled MSI setup scripts for the NewExperience client (WebView2 junction & .NET runtime hardlinks)",
        "foreach ($script in 'create-junctions.ps1', 'create-hardlinks.ps1') {",
        "    if (Test-Path -LiteralPath \"$dir\\$script\") {",
        "        & \"$dir\\$script\" -InstallDir $dir *>&1 | Out-Null",
        "    }",
        "}",
        "if (Test-Path -LiteralPath \"$dir\\WebView2\") {",
        "    & \"$env:SystemRoot\\System32\\icacls.exe\" \"$dir\\WebView2\" /grant '*S-1-15-2-1:(OI)(CI)(RX)' '*S-1-15-2-2:(OI)(CI)(RX)' /C /Q 2>&1 | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "workspaces.exe",
            "Amazon Workspaces"
        ]
    ],
    "uninstaller": {
        "script": [
            "$wv2Link = \"$dir\\NewExperience\\WebView2\"",
            "if ((Test-Path -LiteralPath $wv2Link) -and ((Get-Item -LiteralPath $wv2Link).Attributes -band [IO.FileAttributes]::ReparsePoint)) {",
            "    [IO.Directory]::Delete($wv2Link)",
            "}"
        ]
    },
    "checkver": {
        "url": "https://s3.amazonaws.com/workspaces-client-updates/prod/global/windows/WorkSpacesAppCastx64.xml",
        "regex": "title>Version ([\\d.]+)</"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://d2td7dqidlhjx7.cloudfront.net/prod/global/windows/Amazon+WorkSpaces.msi"
            }
        }
    }
}
