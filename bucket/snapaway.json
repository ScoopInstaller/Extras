{
    "version": "1.2.6",
    "description": "Hide only the apps you chose from screen, taskbar and Alt+Tab with one hotkey, and bring them back in place.",
    "homepage": "https://edenware.app/snapaway/",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://edenware.app/snapaway/bin/SnapAway_setup.exe",
            "hash": "019f94b624ed8b3ead0e58abeec92fae4b358ed602080c2a88443270c883d544"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\$fname\" \"$dir\\_nsis\"",
            "Expand-7zipArchive \"$dir\\_nsis\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\_nsis\",\"$dir\\$fname\" -Recurse -Force"
        ]
    },
    "bin": "SnapAway.exe",
    "shortcuts": [
        [
            "SnapAway.exe",
            "SnapAway"
        ]
    ],
    "checkver": {
        "url": "https://edenware.app/snapaway/pad.xml",
        "regex": "<Program_Version>([\\d.]+)</Program_Version>"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://edenware.app/snapaway/bin/SnapAway_setup.exe"
            }
        }
    }
}
