Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\OpenPencil.pen]
@="Pencil Design File"

[HKEY_CURRENT_USER\Software\Classes\OpenPencil.pen\DefaultIcon]
@="\"$dirpath\\OpenPencil.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\OpenPencil.pen\shell\open\command]
@="\"$dirpath\\OpenPencil.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.pen\OpenWithProgids]
"OpenPencil.pen"=""

[HKEY_CURRENT_USER\Software\Classes\OpenPencil.fig]
@="Figma Design File"

[HKEY_CURRENT_USER\Software\Classes\OpenPencil.fig\DefaultIcon]
@="\"$dirpath\\OpenPencil.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\OpenPencil.fig\shell\open\command]
@="\"$dirpath\\OpenPencil.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.fig\OpenWithProgids]
"OpenPencil.fig"=""
