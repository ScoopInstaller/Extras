Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\TheiaIDE]
@="Open with Theia IDE"
"Icon"="$theiaide"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\TheiaIDE\command]
@="\"$theiaide\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\TheiaIDE]
@="Open with Theia IDE"
"Icon"="$theiaide"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\TheiaIDE\command]
@="\"$theiaide\" \"%V\""
