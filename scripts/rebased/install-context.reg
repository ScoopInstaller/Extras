Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Rebased]
@="Open Folder as Rebased Project"
"Icon"="$app_path"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Rebased\command]
@="\"$app_path\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\Rebased]
@="Open Folder as Rebased Project"
"Icon"="$app_path"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\Rebased\command]
@="\"$app_path\" \"%V\""
